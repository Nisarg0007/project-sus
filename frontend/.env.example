# SUS Frontend Environment Variables
# Copy this file to .env and adjust values for your local setup.

# Backend API base URL (default: http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Data source mode: 'api' (default) or 'mock'
# 'api' mode: frontend calls the real backend
# 'mock' mode: frontend uses hardcoded mock data (for offline development)
VITE_DATA_SOURCE=api
